#!/bin/bash
# 0130-configurar-actualizador.hook.chroot - Prepara /opt/pawos-src
# (carpeta compartida donde el boton "Buscar Actualizaciones" clona/
# actualiza el codigo fuente) y el permiso sudoers NOPASSWD necesario
# para instalar el binario nuevo, sin importar cual usuario de PawOS
# (admin/veterinario/voluntario) use el boton.
set -e

mkdir -p /opt/pawos-src
chown root:pawos-refugio /opt/pawos-src
chmod 2775 /opt/pawos-src

mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/pawos-actualizar << 'SUDOEOF'
%pawos-refugio ALL=(ALL) NOPASSWD: /usr/bin/cp /opt/pawos-src/pawos-refugio-gui /usr/local/bin/pawos-refugio-gui, /usr/bin/cp /opt/pawos-src/pawos-refugio /usr/local/bin/pawos-refugio, /usr/bin/chmod 755 /usr/local/bin/pawos-refugio-gui /usr/local/bin/pawos-refugio
SUDOEOF
chmod 440 /etc/sudoers.d/pawos-actualizar
