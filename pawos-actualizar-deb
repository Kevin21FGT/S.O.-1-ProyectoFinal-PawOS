#!/usr/bin/env python3
"""pawos-actualizar-deb - Descarga e instala la ultima version de
PawOS Refugio publicada como Release (.deb) en GitHub. Pensado para
instalaciones que solo tienen el paquete .deb instalado (sin codigo
fuente ni herramientas de compilacion)."""
import json
import os
import subprocess
import sys
import tempfile
import urllib.request

REPO = "Kevin21FGT/S.O.-1-ProyectoFinal-PawOS"


def pausa():
    try:
        input("Presiona Enter para cerrar...")
    except EOFError:
        pass


def main():
    print("======================================")
    print("      PawOS - Actualizaciones")
    print("======================================")
    print()
    print("Buscando la ultima version...")

    try:
        url = f"https://api.github.com/repos/{REPO}/releases/latest"
        peticion = urllib.request.Request(url, headers={"User-Agent": "PawOS-Refugio"})
        with urllib.request.urlopen(peticion, timeout=8) as resp:
            datos = json.load(resp)
    except Exception:
        print("\nERROR: no se pudo conectar para buscar actualizaciones.")
        pausa()
        sys.exit(1)

    url_deb = None
    nombre_deb = None
    for asset in datos.get("assets", []):
        nombre = asset.get("name", "")
        if nombre.endswith(".deb"):
            url_deb = asset.get("browser_download_url")
            nombre_deb = nombre
            break

    if not url_deb:
        print("\nERROR: no se encontro un instalador .deb en la ultima version.")
        pausa()
        sys.exit(1)

    print(f"\nDescargando {nombre_deb}...")
    destino = os.path.join(tempfile.gettempdir(), nombre_deb)
    try:
        urllib.request.urlretrieve(url_deb, destino)
    except Exception:
        print("\nERROR: no se pudo descargar la actualizacion.")
        pausa()
        sys.exit(1)

    print("\nInstalando actualizacion (puede pedir tu contrasena)...")
    resultado = subprocess.run(["sudo", "apt", "install", "-y", destino])

    try:
        os.remove(destino)
    except OSError:
        pass

    if resultado.returncode != 0:
        print("\nERROR: no se pudo instalar la actualizacion.")
        pausa()
        sys.exit(1)

    print()
    print("======================================")
    print("  Actualizacion completada.")
    print("  Cierra y vuelve a abrir PawOS para ver los cambios.")
    print("======================================")
    pausa()


if __name__ == "__main__":
    main()
