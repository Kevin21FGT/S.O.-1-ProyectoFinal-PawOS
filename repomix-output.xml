            mostrar_mensaje(GTK_WINDOW(ctx->ventana), "Mascota eliminada.", FALSE);
        } else {
            mostrar_mensaje(GTK_WINDOW(ctx->ventana), "No se pudo eliminar la mascota.", TRUE);
        }
    }
