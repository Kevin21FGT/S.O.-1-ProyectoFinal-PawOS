shutil.copy(RUTA, RUTA + ".bak")

cambios = 0

# 1) include de cairo-pdf (ya viene con libgtk-3-dev, no hace falta
#    instalar nada nuevo)
viejo = "#include <gtk/gtk.h>\n"
nuevo = "#include <gtk/gtk.h>\n#include <cairo-pdf.h>\n"
